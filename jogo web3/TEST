funçao das abas
function showTab(id) {
    document.getElementById('modal-shop').classList.remove('active');
    document.getElementById('modal-profile').classList.remove('active');

    document.querySelectorAll('.tab').forEach(tab=>{
        tab.classList.remove('active');
    });

    if(id === 'patio'){
        document.querySelectorAll('.tab')[0].classList.add('active');
    }

    if(id === 'shop'){
        document.getElementById('modal-shop').classList.add('active');
        document.querySelectorAll('.tab')[1].classList.add('active');
    }

    if(id === 'profile'){
        document.getElementById('modal-profile').classList.add('active');
        document.querySelectorAll('.tab')[2].classList.add('active');
    }
}

corrigir update ui
function updateUI() {

    document.getElementById('lvl-val').innerText = state.level;

    document.getElementById('energy-val').innerText =
        state.energy + "/" + getMaxEnergy();

    document.getElementById('energy-fill').style.width =
        (state.energy / getMaxEnergy() * 100) + "%";

    document.getElementById('ecp-val').innerText =
        state.ecp.toLocaleString();

    document.getElementById('header-eco').innerText =
        state.ecp.toLocaleString();

    document.getElementById('header-energy').innerText =
        state.energy + "/" + getMaxEnergy();

    for(let key in state.inventory){
        const el = document.getElementById(`count-${key}`);
        if(el){
            el.innerText = state.inventory[key].toLocaleString();
        }
    }

    const sede = document.getElementById('sede-name');

    if(state.level >= 100){
        sede.innerText = "🌎 Ecopacto City";
    }
    else if(state.level >= 50){
        sede.innerText = "🌆 Recicly City";
    }
    else if(state.level >= 25){
        sede.innerText = "🏭 Galpão";
    }
    else if(state.level >= 10){
        sede.innerText = "🏠 Centro";
    }
    else{
        sede.innerText = "🏚️ Barraco";
    }

    if(wallet){

        document.getElementById('prof-id').innerText =
            wallet.address || "Sem Carteira";

        document.getElementById('user-name').innerText =
            "👤 " + (wallet.name || "Operador");

        document.getElementById('prof-lvl').innerText =
            state.level;
    }
}
